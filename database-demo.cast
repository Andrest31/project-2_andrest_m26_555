[4.847, "o", "\u001b[7mpoetry run database\u001b[27m"]
[0.234, "o", "\u001b[19D\u001b[27mp\u001b[27mo\u001b[27me\u001b[27mt\u001b[27mr\u001b[27my\u001b[27m \u001b[27mr\u001b[27mu\u001b[27mn\u001b[27m \u001b[27md\u001b[27ma\u001b[27mt\u001b[27ma\u001b[27mb\u001b[27ma\u001b[27ms\u001b[27me\u001b[?2004l\r\r\n"]
[0.708, "o", "\r\n***База данных***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n<command> insert into <имя_таблицы> values (<значение1>, ...) - создать запись\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи\r\n<command> select from <имя_таблицы> - прочитать все записи\r\n<command> update <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение> - обновить запись\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись\r\n<command> info <имя_таблицы> - информация о таблице\r\n<command> exit - выход"]
[0.000, "o", " из программы\r\n<command> help - справочная информация\r\n\r\n"]
[0.001, "o", "Введите команду: "]
[7.005, "o", "create_table users name:str age:int is_active:bool"]
[0.791, "o", "\r\n"]
[0.001, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[0.002, "o", "Введите команду: "]
[9.486, "o", "insert into users values (\"Sergei\", 28, true)"]
[1.482, "o", "\r\n"]
[0.000, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\nФункция insert выполнилась за 0.000 секунд.\r\n"]
[0.014, "o", "Введите команду: "]
[5.553, "o", "insert into users values (\"Anna\", 24, false)"]
[0.460, "o", "\r\n"]
[0.000, "o", "Запись с ID=2 успешно добавлена в таблицу \"users\".\r\nФункция insert выполнилась за 0.000 секунд.\r\n"]
[0.001, "o", "Введите команду: "]
[6.341, "o", "select from users"]
[0.532, "o", "\r\n"]
[0.000, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[0.055, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n| 2  |  Anna  |  24 |   False   |\r\n+----+--------+-----+-----------+\r\n"]
[0.000, "o", "Введите команду: "]
[5.938, "o", "select from users where age = 28"]
[0.969, "o", "\r\n"]
[0.001, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[0.001, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[0.000, "o", "Введите команду: "]
[5.031, "o", "select from users where age = 28"]
[1.780, "o", "\r\n"]
[0.001, "o", "Результат получен из кэша.\r\nФункция select выполнилась за 0.000 секунд.\r\n"]
[0.000, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[0.001, "o", "Введите команду: "]
